{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "testTimeout": 30000
}
