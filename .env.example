# Copier vers .env (jamais committé) et remplacer TOUTES les valeurs "change-me".
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# --- MySQL -----------------------------------------------------------
MYSQL_DATABASE=elections
MYSQL_ROOT_PASSWORD=change-me-root
# Comptes applicatifs créés à la première initialisation du volume (docs/02-DATABASE.md §10) :
#   app_migrate  = DDL, uniquement pour `prisma migrate deploy`
#   app_runtime  = application NestJS (pas de UPDATE/DELETE sur ballots, voting_participations, audit_logs)
#   app_readonly = lecture seule, sans ballots ni ballot_choices
APP_MIGRATE_PASSWORD=change-me-migrate
APP_RUNTIME_PASSWORD=change-me-runtime
APP_READONLY_PASSWORD=change-me-readonly

# Pour lancer le backend HORS Docker (npm run start:dev) :
DATABASE_URL=mysql://app_runtime:change-me-runtime@localhost:3306/elections
MIGRATE_DATABASE_URL=mysql://app_migrate:change-me-migrate@localhost:3306/elections

# --- JWT (>= 32 caractères) ------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# --- Stockage S3 (SeaweedFS en local, voir docker-compose.yml) ------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=justificatifs
S3_ACCESS_KEY=change-me-minio
S3_SECRET_KEY=change-me-minio-secret

# --- Authentification (Sprint 2) -----------------------------------------
# Cle AES-256-GCM du secret 2FA : 32 octets en base64, JAMAIS en base. Generer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
# Sel secret du hash des IP dans audit_logs (16 caracteres minimum). Generer comme les secrets JWT.
AUDIT_IP_SALT=
TWO_FACTOR_ISSUER=Elections Etudiantes
# Cle de signature des URL d'acces aux attestations (HMAC, 5 min), >= 32 caracteres. Generer comme les secrets JWT.
FILE_SIGNING_SECRET=

# --- Seed de developpement : `cd backend && npm run seed` (refuse de tourner si NODE_ENV=production) ---
SEED_ADMIN_EMAIL=admin@example.test
# 10 caracteres minimum. Au premier login, le SUPER_ADMIN doit activer sa 2FA (D-15).
SEED_ADMIN_PASSWORD=
# Comptes de demonstration (npm run seed) : un verificateur et un administrateur d'institution. 2FA a configurer au premier login.
SEED_OFFICER_EMAIL=verificateur@example.test
SEED_OFFICER_PASSWORD=
SEED_INSTITUTION_ADMIN_EMAIL=admin-institution@example.test
SEED_INSTITUTION_ADMIN_PASSWORD=

# --- Hors Docker uniquement (docker-compose.yml les fixe : PORT=3000, TRUST_PROXY=1 derriere nginx) ---
# PORT=3000
# Nombre de proxys de confiance devant l'API. 0 = IP de la connexion ; 1 = derriere nginx (sinon le rate limiting voit l'IP de nginx).
# TRUST_PROXY=0
