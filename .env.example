# Copier vers .env (jamais committÃ©) et remplacer TOUTES les valeurs "change-me".
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# --- MySQL -----------------------------------------------------------
MYSQL_DATABASE=elections
MYSQL_ROOT_PASSWORD=change-me-root
# Comptes applicatifs crÃ©Ã©s Ã  la premiÃ¨re initialisation du volume (docs/02-DATABASE.md Â§10) :
#   app_migrate  = DDL, uniquement pour `prisma migrate deploy`
#   app_runtime  = application NestJS (pas de UPDATE/DELETE sur ballots, voting_participations, audit_logs)
#   app_readonly = lecture seule, sans ballots ni ballot_choices
APP_MIGRATE_PASSWORD=change-me-migrate
APP_RUNTIME_PASSWORD=change-me-runtime
APP_READONLY_PASSWORD=change-me-readonly

# Pour lancer le backend HORS Docker (npm run start:dev) :
DATABASE_URL=mysql://app_runtime:change-me-runtime@localhost:3306/elections
MIGRATE_DATABASE_URL=mysql://app_migrate:change-me-migrate@localhost:3306/elections

# --- JWT (>= 32 caractÃ¨res) ------------------------------------------
# GÃ©nÃ©rer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# --- Stockage S3 (SeaweedFS en local, voir docker-compose.yml) ------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=justificatifs
S3_ACCESS_KEY=change-me-minio
S3_SECRET_KEY=change-me-minio-secret
