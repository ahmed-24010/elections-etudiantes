# Copier vers .env et remplacer TOUTES les valeurs. Ne jamais committer .env.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# MySQL (utilisé par docker-compose ; DATABASE_URL est construit par compose pour le conteneur)
MYSQL_DATABASE=elections
MYSQL_USER=elections
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Pour lancer le backend hors Docker :
DATABASE_URL=mysql://elections:change-me@localhost:3306/elections

# JWT : générer avec `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"` (min. 32 caractères)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
TWO_FACTOR_ISSUER=Elections Etudiantes

# Stockage S3-compatible (MinIO en dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=justificatifs
S3_ACCESS_KEY=change-me-minio
S3_SECRET_KEY=change-me-minio-secret

# Seed du premier super-admin (npm run prisma:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
